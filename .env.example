# Core runtime
NODE_ENV=development
PORT=3000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Provider
PROVIDER_BASE_URL=https://alightfree.my.id
PROVIDER_API_KEY=YOUR_PROVIDER_API_KEY
# Server-only secret used to encrypt provider idToken values at rest. Minimum 32 characters.
PROVIDER_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Provider request configuration
PROVIDER_SEND_MAGICLINK_ENABLED=true
PROVIDER_SEND_MAGICLINK_PATH=/api/v1/send-magiclink
PROVIDER_VERIFY_ACCOUNT_PATH=/api/v1/verify-account
PROVIDER_APPLY_PREMIUM_PATH=/api/v1/apply-premium
PROVIDER_TIMEOUT_MS=30000
PROVIDER_MAX_RESPONSE_BYTES=524288
PROVIDER_DAILY_REQUEST_LIMIT=45

# User quota
MAGIC_LINK_DAILY_LIMIT=5
# Backward-compatible alias used only if MAGIC_LINK_DAILY_LIMIT is not set.
DAILY_LOCAL_LIMIT=5

# Provider diagnostic / delivery webhook secret. Keep server-side only.
# When set, the internal provider delivery webhook is enabled.
# PROVIDER_DIAGNOSTIC_SECRET=REPLACE_WITH_PROVIDER_DIAGNOSTIC_SECRET

# Broadcast worker only (not required by the web server itself).
# APP_URL=https://your-app.example
# OWNER_ACCESS_TOKEN=REPLACE_WITH_OWNER_ACCESS_TOKEN

# Portal access token gate
PORTAL_TOKEN_TTL_HOURS=24
# Owner WhatsApp chat URL. Example only; replace with the real owner URL.
# OWNER_WHATSAPP_URL=https://wa.me/628xxxxxxxxxx


# =====================================================
# SIMPLE EMAIL VERIFICATION (GMAIL SMTP)
# =====================================================
AUTH_EMAIL_PROVIDER=gmail
AUTH_EMAIL_FROM=yourgmail@gmail.com
AUTH_EMAIL_FROM_NAME=Jyy'R Amprem
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_TIMEOUT_MS=15000
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=30
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_VERIFICATION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32CHARS_MIN
